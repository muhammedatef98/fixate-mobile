{
  "name": "fixatee-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Fixatee — mobile platform connecting Saudi customers with certified device-repair technicians.",
  "homepage": "https://github.com/muhammedatef98/fixatee-mobile#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammedatef98/fixatee-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/muhammedatef98/fixatee-mobile/issues"
  },
  "license": "MIT",
  "author": "Mohamed Atef <fixate01@gmail.com>",
  "keywords": [
    "react-native",
    "expo",
    "supabase",
    "saudi-arabia",
    "device-repair",
    "marketplace",
    "rtl",
    "arabic"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "jest --forceExit",
    "test:ci": "jest --forceExit --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!.*(react-native|@react-native|expo|@expo|react-navigation|@react-navigation|@unimodules|unimodules|sentry-expo|native-base|react-native-svg|@supabase))"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "@supabase/supabase-js": "^2.87.1",
    "axios": "^1.7.0",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.1.0",
    "expo": "^54.0.34",
    "expo-device": "^8.0.10",
    "expo-file-system": "^19.0.22",
    "expo-font": "^14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "i18next": "^25.7.2",
    "react": "19.1.0",
    "react-i18next": "^16.4.1",
    "react-native": "0.81.5",
    "react-native-error-boundary": "^3.1.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.17",
    "@types/react-native": "^0.73.0",
    "jest": "^29.5.0",
    "jest-expo": "^54.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.1.3"
  }
}
