# ── Required ─────────────────────────────────────────────────────────────────
# Supabase project URL and PUBLISHABLE key (the new sb_publishable_... format).
# Get them at: Supabase Dashboard → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Maps key — only needed if you use the in-app map (live tracking).
# GOOGLE_MAPS_API_KEY=AIzaSy...

# Firebase — only required if you wire up notify-technicians push.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# Environment label used by the app (development | staging | production).
# APP_ENV=development
