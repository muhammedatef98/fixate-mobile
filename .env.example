# ── Required ─────────────────────────────────────────────────────────────────
# Supabase project URL and PUBLISHABLE key (the new sb_publishable_... format).
# Get them at: Supabase Dashboard → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Maps key (Android only — iOS uses Apple Maps).
# NOT a frontend env var; it is consumed by app.config.js at build time
# from an EAS Secret. Set it via:
#   eas secret:create --scope project --name GOOGLE_MAPS_ANDROID_API_KEY --value 'AIzaSy...'
# or the EAS dashboard. Never put the actual key in this file.

# Firebase — only required if you wire up notify-technicians push.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# Environment label used by the app (development | staging | production).
# APP_ENV=development

# ── Edge function secrets (set via `supabase secrets set …`, NOT in this file) ─
# These never reach the client — they live only on Supabase Edge Functions.
#   SUPABASE_SERVICE_ROLE_KEY        — required by delete-account, notify-technicians
#   STRIPE_SECRET_KEY                — required by create-payment
#   STRIPE_PUBLISHABLE_KEY           — returned to client by create-payment
#   FCM_PROJECT_ID                   — Firebase project id
#   FCM_SERVICE_ACCOUNT_JSON         — service-account JSON for FCM HTTP v1
#   RESEND_API_KEY                   — Resend (used by send-otp / email OTP)
#
# Phone OTP via Authentica (https://docs.authentica.sa) — used by
# send-phone-otp / verify-phone-otp edge functions. The API key NEVER ships
# with the mobile bundle.
#   AUTHENTICA_API_KEY               — Authentica X-Authorization header value
#   AUTHENTICA_BASE_URL              — default https://api.authentica.sa/api/v2
#   OTP_DEFAULT_CHANNEL              — sms | whatsapp | email   (default sms)
#   OTP_RESEND_COOLDOWN_SECONDS      — default 60
#   OTP_MAX_ATTEMPTS                 — default 5  (per-phone, 15-min window)
#
# Set them with:
#   supabase secrets set AUTHENTICA_API_KEY=... AUTHENTICA_BASE_URL=https://api.authentica.sa/api/v2 \
#     OTP_DEFAULT_CHANNEL=sms OTP_RESEND_COOLDOWN_SECONDS=60 OTP_MAX_ATTEMPTS=5 \
#     --project-ref &lt;your-project-ref&gt;
