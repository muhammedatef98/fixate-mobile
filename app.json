{
  "expo": {
    "name": "Fixate",
    "slug": "fixatee",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff",
      "translucent": false
    },
    "description": "منصة صيانة الأجهزة الإلكترونية في السعودية - إصلاح أجهزتك بسرعة وسهولة مع فنيين محترفين في موقعك",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixate.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarHidden": true,
        "NSCameraUsageDescription": "يستخدم Fixate الكاميرا لتصوير الجهاز المعطل ووثائق التحقق للفنيين.",
        "NSPhotoLibraryUsageDescription": "يستخدم Fixate مكتبة الصور لاختيار صور الجهاز المعطل ومستندات التحقق.",
        "NSPhotoLibraryAddUsageDescription": "يحفظ Fixate الصور المتعلقة بالطلبات في مكتبة الصور عند الطلب.",
        "NSLocationWhenInUseUsageDescription": "يستخدم Fixate موقعك لتحديد عنوان الخدمة وتمكين تتبع الفني المباشر.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto",
          "whatsapp"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#14AE74"
      },
      "package": "com.fixatee.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withFirebaseNotificationColorFix.js",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "السماح لـ Fixate بالوصول إلى موقعك لتحديد عنوان الخدمة."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج Fixate إلى الوصول إلى صورك لرفع صور الجهاز المعطل ووثائق التحقق.",
          "cameraPermission": "يحتاج Fixate إلى الكاميرا لتصوير الجهاز المعطل ووثائق التحقق."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#14AE74"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "fixate",
          "project": "react-native"
        }
      ],
      "@sentry/react-native",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withIosAllowNonModularIncludes.js",
      "./plugins/withAndroidIconBackgroundColor.js",
      "./plugins/withGradleMemory.js",
      "./plugins/withSentryUploadSkipWhenNoToken.js"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/2499a02f-3849-4712-a374-d1dc6546af1e"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "fixatee",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2499a02f-3849-4712-a374-d1dc6546af1e"
      }
    },
    "owner": "muhammedatef98"
  }
}
