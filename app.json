{
  "expo": {
    "name": "Fixate",
    "slug": "fixate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "منصة صيانة الأجهزة الإلكترونية في السعودية - إصلاح أجهزتك بسرعة وسهولة مع فنيين محترفين في موقعك",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixate.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarHidden": true,
        "NSCameraUsageDescription": "يستخدم Fixate الكاميرا لتصوير الجهاز المعطل ووثائق التحقق للفنيين.",
        "NSPhotoLibraryUsageDescription": "يستخدم Fixate مكتبة الصور لاختيار صور الجهاز المعطل ومستندات التحقق.",
        "NSPhotoLibraryAddUsageDescription": "يحفظ Fixate الصور المتعلقة بالطلبات في مكتبة الصور عند الطلب.",
        "NSLocationWhenInUseUsageDescription": "يستخدم Fixate موقعك لتحديد عنوان الخدمة وتمكين تتبع الفني المباشر.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto",
          "whatsapp"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#55B685"
      },
      "package": "com.fixatee.app",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidStatusBar": {
      "hidden": false,
      "translucent": false,
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "السماح لـ Fixate بالوصول إلى موقعك لتحديد عنوان الخدمة."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج Fixate إلى الوصول إلى صورك لرفع صور الجهاز المعطل ووثائق التحقق.",
          "cameraPermission": "يحتاج Fixate إلى الكاميرا لتصوير الجهاز المعطل ووثائق التحقق."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10b981",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "organization": "fixate",
          "project": "react-native"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      "./plugins/withFirebaseNotificationColorFix.js"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a680cf7b-b1aa-468f-9bd7-6cd9f9e35726"
    },
    "runtimeVersion": "1.0.1",
    "scheme": "fixate",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a680cf7b-b1aa-468f-9bd7-6cd9f9e35726"
      }
    },
    "owner": "muhammedatef98"
  }
}
