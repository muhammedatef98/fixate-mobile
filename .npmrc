# pnpm uses an isolated (non-hoisted) node_modules by default, so transitive
# deps are not exposed at the top level. The @sentry/react-native Xcode build
# phase ("Upload Debug Symbols to Sentry") resolves `@sentry/cli` from the
# project root, which fails under pnpm with MODULE_NOT_FOUND. Hoisting just
# @sentry/cli to the top-level node_modules fixes that resolution.
# (`[]` appends to pnpm's default public-hoist-pattern of *eslint*/*prettier*.)
public-hoist-pattern[]=*@sentry/cli*
